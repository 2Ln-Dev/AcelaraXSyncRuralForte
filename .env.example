# Oracle — conectar como AGROINSU (dono das views V_AX_*)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SID=ORCL
ORACLE_USER=agroinsu
ORACLE_PASSWORD=changeme

# AceleraX API (escrita pela API, não mais direto no banco)
# ACELERA_API_URL = base publicada, sem barra no fim
# ACELERA_API_KEY = chave da integração (header X-Api-Key). Identifica o tenant;
#                   por isso não há mais CODI_TEN aqui.
ACELERA_API_URL=https://app.seudominio.com.br
ACELERA_API_KEY=changeme

# Sync
SYNC_INTERVAL_SECONDS=3600
LOG_FILE_PATH=./sync.log
BATCH_SIZE=1000
LOG_LEVEL=INFO
